  "keyFeatures": [
    "Sales processing with barcode scanning and manual product search",
    "Multiple payment methods: cash, card, and split payments",
    "Real-time inventory tracking and stock alerts",
    "Customer management with loyalty programs and discounts",
    "Shift and cash register management with open/close procedures",
    "Sales and inventory reports with daily, weekly, and monthly views",
    "Returns and refunds processing",
    "User roles and permission management",
    "Receipt printing and digital receipt options",
    "Integration with FacilERP modules (accounting, purchasing, HR)"
